diff --git a/docs/conf.py b/docs/conf.py
index cac9736..af8ab0a 100644
--- a/docs/conf.py
+++ b/docs/conf.py
@@ -98,9 +98,12 @@ html_static_path = ["_static"]
 default_role = "obj"
 
